"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import { supabase } from "../../lib/supabase";

export default function NewFlightPage() {
  const router = useRouter();

  const [flightNumber, setFlightNumber] = useState("");
  const [aircraft, setAircraft] = useState("");
  const [route, setRoute] = useState("");
  const [flightDate, setFlightDate] = useState("");
  const [status, setStatus] = useState("Open");
  const [loading, setLoading] = useState(false);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();

    setLoading(true);

    const {
      data: { user },
    } = await supabase.auth.getUser();

    if (!user) {
      alert("Your session has expired. Please login again.");
      router.push("/");
      return;
    }

    const { error } = await supabase.from("flights").insert({
      flight_number: flightNumber,
      aircraft: aircraft,
      route: route,
      flight_date: flightDate,
      status: status,
      created_by: user.id,
    });

    setLoading(false);

    if (error) {
      alert(error.message);
      return;
    }

    alert("Flight created successfully!");

    router.push("/dashboard");
  };

  return (
    <main className="dashboard-page">
      <header className="dashboard-header">
        <div>
          <div className="dashboard-logo">TRANSOM</div>
          <div className="dashboard-subtitle">
            FLIGHT SERVICE CAPTURE
          </div>
        </div>

        <button
          className="logout-button"
          onClick={async () => {
            await supabase.auth.signOut();
            router.push("/");
          }}
        >
          LOGOUT
        </button>
      </header>

      <section className="dashboard-content">
        <div className="welcome-section">
          <h1>New Flight</h1>
          <p>Create a new flight service capture record.</p>
        </div>

        <section className="flights-section">
          <form
            onSubmit={handleSubmit}
            style={{
              padding: "30px",
              display: "grid",
              gap: "18px",
            }}
          >
            <div>
              <label>Flight Number</label>
              <input
                type="text"
                placeholder="e.g. TC101"
                value={flightNumber}
                onChange={(e) => setFlightNumber(e.target.value)}
                required
              />
            </div>

            <div>
              <label>Aircraft</label>
              <input
                type="text"
                placeholder="e.g. Dash 8 Q400"
                value={aircraft}
                onChange={(e) => setAircraft(e.target.value)}
                required
              />
            </div>

            <div>
              <label>Route</label>
              <input
                type="text"
                placeholder="e.g. DAR → ZNZ"
                value={route}
                onChange={(e) => setRoute(e.target.value)}
                required
              />
            </div>

            <div>
              <label>Flight Date</label>
              <input
                type="date"
                value={flightDate}
                onChange={(e) => setFlightDate(e.target.value)}
                required
              />
            </div>

            <div>
              <label>Status</label>
              <select
                value={status}
                onChange={(e) => setStatus(e.target.value)}
              >
                <option value="Open">Open</option>
                <option value="In Progress">In Progress</option>
                <option value="Closed - No Delay">
                  Closed - No Delay
                </option>
                <option value="Closed - With Delay">
                  Closed - With Delay
                </option>
              </select>
            </div>

            <div
              style={{
                display: "flex",
                gap: "12px",
                marginTop: "10px",
              }}
            >
              <button
                type="button"
                className="logout-button"
                style={{
                  background: "#071d41",
                  color: "#fff",
                }}
                onClick={() => router.push("/dashboard")}
              >
                CANCEL
              </button>

              <button
                type="submit"
                className="new-flight-button"
                disabled={loading}
              >
                {loading ? "SAVING..." : "SAVE FLIGHT"}
              </button>
            </div>
          </form>
        </section>
      </section>

      <footer className="dashboard-footer">
        <p>TRANSOM Flight Service Capture</p>
        <span>Authorized Personnel Only</span>
      </footer>
    </main>
  );
}
